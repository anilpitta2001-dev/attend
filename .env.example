# Existing attendance scraper
BITS_PORTAL_USERNAME=
BITS_PORTAL_PASSWORD=
BITS_PORTAL_URL=https://balaji.winnou.net

# Existing Cloudflare Worker proxy
USE_PROXY=true
PROXY_URL=
PROXY_KEY=

# Public/User Telegram Bot: @live_attendance_checker_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Existing Attendance API
ATTENDANCE_API_URL=https://attendancechecker-o41l.onrender.com/index.php?api=attendance
ATTENDANCE_API_KEY=

# Existing Admin/Logger Bot: @stu_checked_info_bot
# This bot is now the private Admin Bot AND continues to receive lookup logs.
ADMIN_BOT_TOKEN=
ADMIN_WEBHOOK_SECRET=

# Admin destination for support requests from @live_attendance_checker_bot.
# Set ADMIN_CHAT_ID to your Telegram user/chat ID for delivery in @stu_checked_info_bot.
# ADMIN_IDS should contain the Telegram IDs allowed to run admin commands.
# ADMIN_CHAT_ID is retained for backward compatibility.
ADMIN_IDS=
ADMIN_CHAT_ID=

# Supabase PostgreSQL. Use the connection string from Supabase / Render secret env.
# Keep this secret out of GitHub and frontend code.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres?sslmode=require
# Optional alternative to DATABASE_URL:
# DB_HOST=
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=
# DB_SSLMODE=require

# Scheduled attendance cron (existing feature)
TELEGRAM_CHAT_ID=
ATTENDANCE_ROLL=
CRON_SECRET=

# Set true to show the planned maintenance message for every attendance request
MAINTENANCE_MODE=false

# Required on BOTH Render services: only the Cloudflare webhook controller knows this secret.
BACKEND_PROXY_SECRET=
